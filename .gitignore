# Extracted APKs — copyrighted binaries, do not redistribute.
# Hashes and provenance live in notes/ instead.
apk/*.apk

# JADX decompiled output — large, derivative of third-party SDK code.
decoded/

# Downloaded tooling (e.g. JADX release) — fetch from upstream, see notes/.
tools/

# Traffic captures — may contain device/account identifiers even after
# sanitizing; keep local only.
captures/*
!captures/.gitkeep

# Local-only sensitive findings (live third-party credentials, etc.) —
# never publish these, even redacted excerpts.
notes/local-only-*

# OS / editor noise
.DS_Store
*.swp
